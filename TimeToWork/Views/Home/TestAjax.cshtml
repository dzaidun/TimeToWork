@{
    ViewData["Title"] = "Test URLs";
}

<h1>Test AJAX URLs</h1>

<div class="alert alert-info">
    <h3>Generated URLs:</h3>
    <ul>
        <li>QuickCreate Clients: <strong>@Url.Action("QuickCreate", "Clients")</strong></li>
        <li>QuickCreate Services: <strong>@Url.Action("QuickCreate", "Services")</strong></li>
        <li>QuickCreate ServiceProviders: <strong>@Url.Action("QuickCreate", "ServiceProviders")</strong></li>
        <li>QuickCreate PlaceOfWorks: <strong>@Url.Action("QuickCreate", "PlaceOfWorks")</strong></li>
        <li>GetPlaceOfWorks: <strong>@Url.Action("GetPlaceOfWorks", "ServiceProviders")</strong></li>
    </ul>
</div>

<button id="testClient" class="btn btn-primary">Test Client QuickCreate</button>
<button id="testService" class="btn btn-primary">Test Service QuickCreate</button>
<button id="testServiceProvider" class="btn btn-primary">Test ServiceProvider QuickCreate</button>
<button id="testPlaceOfWork" class="btn btn-primary">Test PlaceOfWork QuickCreate</button>

<div id="result" class="mt-3"></div>

@section Scripts {
<script>
    $(document).ready(function() {
        $('#testClient').click(function() {
            var testData = {
                LastName: "TestLast",
                FirstName: "TestFirst", 
                PhoneNumber: "1234567890"
            };
            
            $.ajax({
                url: '@Url.Action("QuickCreate", "Clients")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(testData),
                success: function(response) {
                    $('#result').html('<div class="alert alert-success">Client Success: ' + JSON.stringify(response) + '</div>');
                },
                error: function(xhr) {
                    $('#result').html('<div class="alert alert-danger">Client Error: ' + xhr.status + ' - ' + xhr.responseText + '</div>');
                }
            });
        });

        $('#testService').click(function() {
            var testData = {
                ServiceName: "TestService",
                ShortDescription: "Short desc",
                Description: "Long description",
                Price: 100,
                ЕxecutionTimeHours: 1,
                ЕxecutionTimeMinutes: 30
            };
            
            $.ajax({
                url: '@Url.Action("QuickCreate", "Services")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(testData),
                success: function(response) {
                    $('#result').html('<div class="alert alert-success">Service Success: ' + JSON.stringify(response) + '</div>');
                },
                error: function(xhr) {
                    $('#result').html('<div class="alert alert-danger">Service Error: ' + xhr.status + ' - ' + xhr.responseText + '</div>');
                }
            });
        });

        $('#testServiceProvider').click(function() {
            var testData = {
                LastName: "ProviderLast",
                FirstName: "ProviderFirst",
                HireDate: "2024-01-01",
                PlaceOfWorkID: 1
            };
            
            $.ajax({
                url: '@Url.Action("QuickCreate", "ServiceProviders")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(testData),
                success: function(response) {
                    $('#result').html('<div class="alert alert-success">ServiceProvider Success: ' + JSON.stringify(response) + '</div>');
                },
                error: function(xhr) {
                    $('#result').html('<div class="alert alert-danger">ServiceProvider Error: ' + xhr.status + ' - ' + xhr.responseText + '</div>');
                }
            });
        });

        $('#testPlaceOfWork').click(function() {
            var testData = {
                Location: "Test Location 123"
            };
            
            $.ajax({
                url: '@Url.Action("QuickCreate", "PlaceOfWorks")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(testData),
                success: function(response) {
                    $('#result').html('<div class="alert alert-success">PlaceOfWork Success: ' + JSON.stringify(response) + '</div>');
                },
                error: function(xhr) {
                    $('#result').html('<div class="alert alert-danger">PlaceOfWork Error: ' + xhr.status + ' - ' + xhr.responseText + '</div>');
                }
            });
        });
    });
</script>
}
