<div class="modal fade" id="quickAddServiceModal" tabindex="-1" aria-labelledby="quickAddServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickAddServiceModalLabel">Quick Add Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="quickAddServiceForm">
                <div class="modal-body">
                    <div class="alert alert-danger d-none" id="quickAddServiceErrors"></div>
                    
                    <div class="form-group mb-3">
                        <label for="quickService_ServiceName" class="control-label">Service Name</label>
                        <input type="text" class="form-control" id="quickService_ServiceName" name="ServiceName" required maxlength="50" minlength="3" />
                        <span class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label for="quickService_ShortDescription" class="control-label">Short Description</label>
                        <input type="text" class="form-control" id="quickService_ShortDescription" name="ShortDescription" required />
                        <span class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label for="quickService_Description" class="control-label">Description</label>
                        <textarea class="form-control" id="quickService_Description" name="Description" rows="3"></textarea>
                        <span class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label for="quickService_Price" class="control-label">Price</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" id="quickService_Price" name="Price" required min="0" />
                            <span class="input-group-text">.00</span>
                        </div>
                        <span class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label class="control-label">Execution Time Hours</label>
                            <input type="number" class="form-control" id="quickService_Hours" name="ЕxecutionTimeHours" required min="0" max="23" value="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="control-label">Execution Time Minutes</label>
                            <input type="number" class="form-control" id="quickService_Minutes" name="ЕxecutionTimeMinutes" required min="0" max="59" value="0" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Service</button>
                </div>
            </form>
        </div>
    </div>
</div>
