<div class="modal fade" id="quickAddClientModal" tabindex="-1" aria-labelledby="quickAddClientModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickAddClientModalLabel">Quick Add Client</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="quickAddClientForm">
                <div class="modal-body">
                    <div class="alert alert-danger d-none" id="quickAddClientErrors"></div>
                    
                    <div class="form-group mb-3">
                        <label for="quickClient_LastName" class="control-label">Last Name</label>
                        <input type="text" class="form-control" id="quickClient_LastName" name="LastName" required />
                        <span class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label for="quickClient_FirstName" class="control-label">First Name</label>
                        <input type="text" class="form-control" id="quickClient_FirstName" name="FirstName" required />
                        <span class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label for="quickClient_PhoneNumber" class="control-label">Phone Number</label>
                        <input type="text" class="form-control" id="quickClient_PhoneNumber" name="PhoneNumber" required />
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Client</button>
                </div>
            </form>
        </div>
    </div>
</div>
