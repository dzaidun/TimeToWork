<div class="modal fade" id="quickAddPlaceOfWorkModal" tabindex="-1" aria-labelledby="quickAddPlaceOfWorkModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickAddPlaceOfWorkModalLabel">Quick Add Workplace</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="quickAddPlaceOfWorkForm">
                <div class="modal-body">
                    <div class="alert alert-danger d-none" id="quickAddPlaceOfWorkErrors"></div>
                    
                    <div class="form-group mb-3">
                        <label for="quickPlaceOfWork_Location" class="control-label">Workplace Location</label>
                        <input type="text" class="form-control" id="quickPlaceOfWork_Location" name="Location" required maxlength="250" />
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Workplace</button>
                </div>
            </form>
        </div>
    </div>
</div>
