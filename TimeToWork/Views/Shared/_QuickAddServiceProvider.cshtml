<div class="modal fade" id="quickAddServiceProviderModal" tabindex="-1" aria-labelledby="quickAddServiceProviderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickAddServiceProviderModalLabel">Quick Add Executor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="quickAddServiceProviderForm">
                <div class="modal-body">
                    <div class="alert alert-danger d-none" id="quickAddServiceProviderErrors"></div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="quickServiceProvider_LastName" class="control-label">Last Name</label>
                                <input type="text" class="form-control" id="quickServiceProvider_LastName" name="LastName" required maxlength="50" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="quickServiceProvider_FirstName" class="control-label">First Name</label>
                                <input type="text" class="form-control" id="quickServiceProvider_FirstName" name="FirstName" required maxlength="50" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="quickServiceProvider_HireDate" class="control-label">Hire Date</label>
                                <input type="date" class="form-control" id="quickServiceProvider_HireDate" name="HireDate" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="quickServiceProvider_PlaceOfWorkID" class="control-label">Workplace</label>
                                <select class="form-control" id="quickServiceProvider_PlaceOfWorkID" name="PlaceOfWorkID" required>
                                    <option value="" selected disabled>Select Workplace</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="control-label">Services (optional - can be assigned later)</label>
                        <div id="quickServiceProvider_Services" class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                            <div class="text-muted">Loading services...</div>
                        </div>
                        <small class="form-text text-muted">Select services this executor can perform</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Executor</button>
                </div>
            </form>
        </div>
    </div>
</div>
