@model TimeToWork.Models.Appointment

@{
    ViewData["Title"] = "Edit";
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <h1>Edit Appointment</h1>
        <hr />
        <form asp-action="Edit" class="d-grid gap-2">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AppointmentId" />

            <div class="form-group">
                Client
				<div class="input-group">
					<select asp-for="ClientId" class="form-control searchable-select" asp-items="ViewBag.ClientId" data-placeholder="Select Client"></select>
					<button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#quickAddClientModal" title="Add new client">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16">
							<path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
							<path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
						</svg>
					</button>
				</div>
                <span asp-validation-for="ClientId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Service</label>
				<div class="input-group">
					<select id="lstServiceId" asp-for="ServiceId" class="form-control searchable-select" asp-items="ViewBag.ServiceId" onchange="FillServiceProvider(this, 'lstServiceProvider');" data-placeholder="Select Service"></select>
					<button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#quickAddServiceModal" title="Add new service">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16">
							<path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
							<path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
						</svg>
					</button>
				</div>
                <span asp-validation-for="ServiceId" class="text-danger" />
            </div>

            <div class="form-group">
                <label class="control-label">Executor</label>
				<div class="input-group">
					<select id="lstServiceProvider" asp-for="ServiceProviderID" class="form-control searchable-select" asp-items="ViewBag.ServiceProviderID" data-placeholder="Select Executor"></select>
					<button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#quickAddServiceProviderModal" title="Add new executor">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16">
							<path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
							<path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
						</svg>
					</button>
				</div>
                <span asp-validation-for="ServiceProviderID" class="text-danger" />
            </div>
            <div class="form-group">
                Date
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="row mt-2">
                <div class="col-md-6 ">
                    <a asp-action="Index" class="btn btn-warning w-100">
                        <span style="margin-right:10px">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-left" viewBox="0 0 16 16">
								<path fill-rule="evenodd" d="M6 12.5a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-8a.5.5 0 0 0-.5.5v2a.5.5 0 0 1-1 0v-2A1.5 1.5 0 0 1 6.5 2h8A1.5 1.5 0 0 1 16 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 5 12.5v-2a.5.5 0 0 1 1 0v2z" />
								<path fill-rule="evenodd" d="M.146 8.354a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L1.707 7.5H10.5a.5.5 0 0 1 0 1H1.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3z" />
							</svg>
						</span>
						Back to List
                    </a>
                </div>
                <div class="col-md-6 ">
                    <div class="form-group">
                        <input type="submit" value="Save" class="btn btn-success w-100" />
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Include Quick Add Modals -->
@await Html.PartialAsync("_QuickAddService")
@await Html.PartialAsync("_QuickAddServiceProvider")
@await Html.PartialAsync("_QuickAddClient")


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

<script type="text/javascript">

    function FillServiceProvider(lstServiceCtrl, lstServiceProviderId) {
        var lstServiceProvider = $("#" + lstServiceProviderId);
        
        // Destroy Select2 before clearing
        if (lstServiceProvider.hasClass("select2-hidden-accessible")) {
            lstServiceProvider.select2('destroy');
        }
        
        lstServiceProvider.empty();

        var selectedService = lstServiceCtrl.options[lstServiceCtrl.selectedIndex].value;

        if (selectedService != null && selectedService != '') {
            $.getJSON('@Url.Action("GetServiceProviderByService")', { serviceId: selectedService }, function (serviceProviders) {
                if (serviceProviders != null && !jQuery.isEmptyObject(serviceProviders)) {
                    $.each(serviceProviders, function (index, serviceProvider) {
                        lstServiceProvider.append($('<option/>', {
                            value: serviceProvider.value,
                            text: serviceProvider.text
                        }));
                    });
                }
                
                // Re-initialize Select2 after populating
                lstServiceProvider.select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: 'Select Executor',
                    allowClear: true
                });
            });
        } else {
            // Re-initialize Select2 even if empty
            lstServiceProvider.select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: 'Select Executor',
                allowClear: true
            });
        }
    }

	// Quick Add Client functionality
	$(document).ready(function() {
		$('#quickAddClientForm').on('submit', function(e) {
			e.preventDefault();
			
			var formData = {
				LastName: $('#quickClient_LastName').val(),
				FirstName: $('#quickClient_FirstName').val(),
				PhoneNumber: $('#quickClient_PhoneNumber').val()
			};
			
			console.log('Sending client data:', formData);
			
			$.ajax({
				url: '@Url.Action("QuickCreate", "Clients")',
				type: 'POST',
				contentType: 'application/json',
				data: JSON.stringify(formData),
				success: function(response) {
					console.log('Client response:', response);
					if (response.success) {
						var newOption = new Option(response.text, response.id, true, true);
						$('#ClientId').append(newOption).trigger('change');
						$('#quickAddClientModal').modal('hide');
						$('#quickAddClientForm')[0].reset();
						$('#quickAddClientErrors').addClass('d-none');
						
						// Show success message
						showSuccessToast('Client "' + response.text + '" created successfully!');
					} else {
						$('#quickAddClientErrors').removeClass('d-none').text(response.message);
					}
				},
				error: function(xhr, status, error) {
					console.error('Client error:', xhr.responseText);
					var errorMsg = 'Error adding client. ';
					if (xhr.responseText) {
						try {
							var errorData = JSON.parse(xhr.responseText);
							errorMsg += errorData.message || xhr.responseText;
						} catch(e) {
							errorMsg += xhr.responseText;
						}
					}
					$('#quickAddClientErrors').removeClass('d-none').text(errorMsg);
				}
			});
		});
		
		$('#quickAddClientModal').on('hidden.bs.modal', function () {
			$('#quickAddClientForm')[0].reset();
			$('#quickAddClientErrors').addClass('d-none').text('');
		});

		// Quick Add Service functionality
		$('#quickAddServiceForm').on('submit', function(e) {
			e.preventDefault();
			
			var formData = {
				ServiceName: $('#quickService_ServiceName').val(),
				ShortDescription: $('#quickService_ShortDescription').val(),
				Description: $('#quickService_Description').val(),
				Price: parseInt($('#quickService_Price').val()),
				ЕxecutionTimeHours: parseInt($('#quickService_Hours').val()),
				ЕxecutionTimeMinutes: parseInt($('#quickService_Minutes').val())
			};
			
			console.log('Sending service data:', formData);
			
			$.ajax({
				url: '@Url.Action("QuickCreate", "Services")',
				type: 'POST',
				contentType: 'application/json',
				data: JSON.stringify(formData),
				success: function(response) {
					console.log('Service response:', response);
					if (response.success) {
						var newOption = new Option(response.text, response.id, true, true);
						$('#lstServiceId').append(newOption).trigger('change');
						$('#quickAddServiceModal').modal('hide');
						$('#quickAddServiceForm')[0].reset();
						$('#quickAddServiceErrors').addClass('d-none');
						
						// Show success message
						showSuccessToast('Service "' + response.text + '" created successfully!');
					} else {
						$('#quickAddServiceErrors').removeClass('d-none').text(response.message);
					}
				},
				error: function(xhr, status, error) {
					console.error('Service error:', xhr.responseText);
					var errorMsg = 'Error adding service. ';
					if (xhr.responseText) {
						try {
							var errorData = JSON.parse(xhr.responseText);
							errorMsg += errorData.message || xhr.responseText;
						} catch(e) {
							errorMsg += xhr.responseText;
						}
					}
					$('#quickAddServiceErrors').removeClass('d-none').text(errorMsg);
				}
			});
		});
		
		$('#quickAddServiceModal').on('hidden.bs.modal', function () {
			$('#quickAddServiceForm')[0].reset();
			$('#quickAddServiceErrors').addClass('d-none').text('');
		});

		// Quick Add ServiceProvider functionality
		// Load workplaces and services when modal opens
		$('#quickAddServiceProviderModal').on('show.bs.modal', function () {
			// Load workplaces
			$.ajax({
				url: '@Url.Action("GetPlaceOfWorks", "ServiceProviders")',
				type: 'GET',
				success: function(data) {
					console.log('Workplaces loaded:', data);
					var select = $('#quickServiceProvider_PlaceOfWorkID');
					select.empty();
					select.append('<option value="" selected disabled>Select Workplace</option>');
					$.each(data, function(index, item) {
						select.append($('<option></option>').val(item.value).text(item.text));
					});
				},
				error: function(xhr) {
					console.error('Error loading workplaces:', xhr.responseText);
				}
			});

			// Load services
			$.ajax({
				url: '@Url.Action("GetServices", "ServiceProviders")',
				type: 'GET',
				success: function(data) {
					console.log('Services loaded:', data);
					var container = $('#quickServiceProvider_Services');
					container.empty();
					
					if (data && data.length > 0) {
						$.each(data, function(index, service) {
							var checkboxHtml = 
								'<div class="form-check">' +
									'<input class="form-check-input service-checkbox" type="checkbox" value="' + service.id + '" id="service_' + service.id + '">' +
									'<label class="form-check-label" for="service_' + service.id + '">' +
										service.name +
									'</label>' +
								'</div>';
							container.append(checkboxHtml);
						});
					} else {
						container.html('<div class="text-muted">No services available</div>');
					}
				},
				error: function(xhr) {
					console.error('Error loading services:', xhr.responseText);
					$('#quickServiceProvider_Services').html('<div class="text-danger">Error loading services</div>');
				}
			});
		});

		$('#quickAddServiceProviderForm').on('submit', function(e) {
			e.preventDefault();
			
			// Collect selected services
			var selectedServices = [];
			$('.service-checkbox:checked').each(function() {
				selectedServices.push(parseInt($(this).val()));
			});

			var formData = {
				LastName: $('#quickServiceProvider_LastName').val(),
				FirstName: $('#quickServiceProvider_FirstName').val(),
				HireDate: $('#quickServiceProvider_HireDate').val(),
				PlaceOfWorkID: parseInt($('#quickServiceProvider_PlaceOfWorkID').val()),
				SelectedServices: selectedServices
			};
			
			console.log('Sending service provider data:', formData);
			
			$.ajax({
				url: '@Url.Action("QuickCreate", "ServiceProviders")',
				type: 'POST',
				contentType: 'application/json',
				data: JSON.stringify(formData),
				success: function(response) {
					console.log('ServiceProvider response:', response);
					if (response.success) {
						// Close modal and reset form
						$('#quickAddServiceProviderModal').modal('hide');
						$('#quickAddServiceProviderForm')[0].reset();
						$('#quickAddServiceProviderErrors').addClass('d-none');
						
						// Show success message
						showSuccessToast('Executor "' + response.text + '" created successfully!');
						
						// Check if a service is selected
						var selectedServiceId = $('#lstServiceId').val();
						if (selectedServiceId) {
							// Refresh the service provider list based on the selected service
							// This ensures only compatible service providers are shown
							console.log('Refreshing service provider list for service:', selectedServiceId);
							FillServiceProvider(document.getElementById('lstServiceId'), 'lstServiceProvider');
						}
					} else {
						$('#quickAddServiceProviderErrors').removeClass('d-none').text(response.message);
					}
				},
				error: function(xhr, status, error) {
					console.error('ServiceProvider error:', xhr.responseText);
					var errorMsg = 'Error adding executor. ';
					if (xhr.responseText) {
						try {
							var errorData = JSON.parse(xhr.responseText);
							errorMsg += errorData.message || xhr.responseText;
						} catch(e) {
							errorMsg += xhr.responseText;
						}
					}
					$('#quickAddServiceProviderErrors').removeClass('d-none').text(errorMsg);
				}
			});
		});
		
		$('#quickAddServiceProviderModal').on('hidden.bs.modal', function () {
			$('#quickAddServiceProviderForm')[0].reset();
			$('#quickAddServiceProviderErrors').addClass('d-none').text('');
			$('#quickServiceProvider_Services').html('<div class="text-muted">Loading services...</div>');
		});
	});

</script>
}
